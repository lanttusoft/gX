#ai: generate a best-effort source revision for offline bug reports. A source
#   archive without its own Git root reports "unknown" instead of inheriting an
#   unrelated enclosing repository.
if(NOT DEFINED GX_SOURCE_DIR OR NOT DEFINED GX_OUTPUT)
    message(FATAL_ERROR "GenerateBuildInfo.cmake requires GX_SOURCE_DIR and GX_OUTPUT")
endif()

set(gx_revision "unknown")
execute_process(
    COMMAND git -C "${GX_SOURCE_DIR}" rev-parse --show-toplevel
    RESULT_VARIABLE gx_toplevel_result
    OUTPUT_VARIABLE gx_toplevel
    ERROR_QUIET
    OUTPUT_STRIP_TRAILING_WHITESPACE)
if(gx_toplevel_result EQUAL 0)
    get_filename_component(gx_source_real "${GX_SOURCE_DIR}" REALPATH)
    get_filename_component(gx_toplevel_real "${gx_toplevel}" REALPATH)
    if(gx_source_real STREQUAL gx_toplevel_real)
        execute_process(
            COMMAND git -C "${GX_SOURCE_DIR}" rev-parse --short=12 HEAD
            RESULT_VARIABLE gx_head_result
            OUTPUT_VARIABLE gx_head
            ERROR_QUIET
            OUTPUT_STRIP_TRAILING_WHITESPACE)
        if(gx_head_result EQUAL 0 AND gx_head MATCHES "^[0-9a-f]+$")
            set(gx_revision "${gx_head}")
            execute_process(
                COMMAND git -C "${GX_SOURCE_DIR}" status --porcelain --untracked-files=no
                RESULT_VARIABLE gx_status_result
                OUTPUT_VARIABLE gx_status
                ERROR_QUIET
                OUTPUT_STRIP_TRAILING_WHITESPACE)
            if(gx_status_result EQUAL 0 AND NOT gx_status STREQUAL "")
                string(APPEND gx_revision "-dirty")
            endif()
        endif()
    endif()
endif()

set(gx_content "/* generated by cmake/GenerateBuildInfo.cmake - do not edit */\n#ifndef GX_BUILD_INFO_H\n#define GX_BUILD_INFO_H\n#define GX_BUILD_REVISION \"${gx_revision}\"\n#endif\n")
set(gx_existing "")
if(EXISTS "${GX_OUTPUT}")
    file(READ "${GX_OUTPUT}" gx_existing)
endif()
if(NOT gx_existing STREQUAL gx_content)
    file(WRITE "${GX_OUTPUT}" "${gx_content}")
endif()
