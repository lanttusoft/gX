diff --git a/src/platforms/rcore_desktop_glfw.c b/src/platforms/rcore_desktop_glfw.c
index 191a3130..75d20619 100644
--- a/src/platforms/rcore_desktop_glfw.c
+++ b/src/platforms/rcore_desktop_glfw.c
@@ -1587,5 +1587,36 @@ int InitPlatform(void)
         glfwWindowHint(GLFW_CONTEXT_CREATION_API, GLFW_EGL_CONTEXT_API);
     }

+    //opencode: GX_GL43_CONTEXT opts into a desktop OpenGL 4.3 core context.
+    //   GX_GL30_CONTEXT / GX_GL31_CONTEXT / GX_GL32_CONTEXT request desktop
+    //   GL 3.x contexts (ANY profile maximizes driver acceptance).
+    //   GLFW hints are last-write-wins, so the opt-in overrides GRAPHICS_API.
+    //   The default remains the context selected by raylib.
+    {
+        int reqMajor = 3;
+        int reqMinor = -1;
+        const char *gl43 = getenv("GX_GL43_CONTEXT");
+        const char *gl30 = getenv("GX_GL30_CONTEXT");
+        const char *gl31 = getenv("GX_GL31_CONTEXT");
+        const char *gl32 = getenv("GX_GL32_CONTEXT");
+        if ((gl43 != NULL) && (gl43[0] != '\0') && (gl43[0] != '0'))
+        {
+            reqMajor = 4;
+            reqMinor = 3;
+        }
+        else if ((gl30 != NULL) && (gl30[0] != '\0') && (gl30[0] != '0')) reqMinor = 0;
+        else if ((gl31 != NULL) && (gl31[0] != '\0') && (gl31[0] != '0')) reqMinor = 1;
+        else if ((gl32 != NULL) && (gl32[0] != '\0') && (gl32[0] != '0')) reqMinor = 2;
+        if (reqMinor >= 0)
+        {
+            glfwWindowHint(GLFW_CLIENT_API, GLFW_OPENGL_API);
+            glfwWindowHint(GLFW_CONTEXT_VERSION_MAJOR, reqMajor);
+            glfwWindowHint(GLFW_CONTEXT_VERSION_MINOR, reqMinor);
+            glfwWindowHint(GLFW_OPENGL_PROFILE, reqMajor >= 4 ? GLFW_OPENGL_CORE_PROFILE : GLFW_OPENGL_ANY_PROFILE);
+            glfwWindowHint(GLFW_OPENGL_FORWARD_COMPAT, GLFW_FALSE);
+            TRACELOG(LOG_INFO, "GLFW: gX experiment requesting desktop OpenGL %d.%d context", reqMajor, reqMinor);
+        }
+    }
+
     // NOTE: GLFW 3.4+ defers initialization of the Joystick subsystem on the first call to any Joystick related functions
     // Forcing this initialization here avoids doing it on PollInputEvents() called by EndDrawing() after first frame has been drawn
     // The initialization will still happen and possible delays still occur, but before the window is shown, which is a nicer experience
